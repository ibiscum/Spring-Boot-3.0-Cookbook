<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.packt</groupId>
	<artifactId>recipe2-4-footballauth</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>recipe2-4-footballauth</name>
	<description>Demo project for Spring Boot 3 Cookbook</description>

	<properties>
		<java.version>25</java.version>
        <tomcat.version>[11.0.22,)</tomcat.version>
	</properties>

    <dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-authorization-server</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <image>
            <cleanCache>true</cleanCache>
        </image>
          <docker>
            <host>unix:///run/user/1000/docker.sock</host>
            <bindHostToBuilder>true</bindHostToBuilder>
          </docker>
        </configuration>
			</plugin>
		</plugins>
	</build>

</project>
